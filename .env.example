# Environment template. Copy to `.env` and fill in real values.
#
# This file is tracked; `.env` is not. Never put a real credential in this
# file -- every value below is a placeholder. In production these are
# injected from Secret Manager (ADR-0032), not from a file.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# `cloud` enables cloud environment rules and requires an explicit science
# mode below. Anything else (or unset) uses local environment rules.
# This flag does not independently select real scientific providers.
PHYTO_ENV=local

# Authentication dry-run, independent of scientific execution. In cloud,
# explicit mock science also requires PHYTO_DRY_RUN=1.
# PHYTO_DRY_RUN=1

# ---------------------------------------------------------------------------
# Scientific execution (source contract, 2026-11-08; subject to main final)
# ---------------------------------------------------------------------------
# Explicitly required in every environment, including local. Missing or
# invalid configuration fails closed. Real mode never falls back to mock
# prediction or an LLM and is NOT scientific validation.
# Allowed values: mock | real
PHYTO_SCIENTIFIC_EXECUTION=mock

# Real mode supports only reference_hsqc_identify / reference_hsqc.rank.
# Both files are required in real mode and are loaded locally at startup.
# No default reference library is provided. Use curated CSV/UTF-8 JSON files
# with verified sources and reuse licenses; see docs/ORCHESTRATOR_EXECUTION.md.
# PHYTO_STRUCTURE_DB_PATH=/absolute/path/to/structures.csv
# PHYTO_HSQC_REFERENCE_LIBRARY=/absolute/path/to/references.json

# ---------------------------------------------------------------------------
# Stripe (ADR-0047)
# ---------------------------------------------------------------------------
# API secret key. Without it, RealStripeClient refuses with 503 rather than
# silently using the mock in production.
STRIPE_SECRET_KEY=sk_test_...

# One recurring monthly price id per subscribable plan.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_LAB=price_...
STRIPE_PRICE_DEPARTMENT=price_...

# Webhook signing secret (Dashboard -> Developers -> Webhooks -> endpoint ->
# "Signing secret"). The handler verifies Stripe-Signature against this value
# and fails closed when it is unset. Set the real value in Secret Manager;
# the value here is a dummy.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------------------------
# Application URLs and sharing
# ---------------------------------------------------------------------------
PHYTO_APP_BASE_URL=http://localhost:8000

# HMAC key for share tokens (ADR-0044). Must be stable across restarts or
# every outstanding share link stops working.
SHARE_HMAC_KEY=change-me-in-production
SHARE_RATE_LIMIT_PER_MIN=30

# ---------------------------------------------------------------------------
# Auth service (ADR-0032, ADR-0045)
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=phyto-local

# Path to the Firebase service-account JSON. Required only when PHYTO_ENV=cloud;
# the local plane uses the mock verifier.
FIREBASE_CREDENTIALS_PATH=

# Override the auth gate's default (on in cloud, off locally): "1" enforces,
# "0" disables. Leave unset unless you are testing one specific mode.
PHYTO_AUTH_ENABLED=

# Monthly free allowance in tokens (ADR-0045).
PHYTO_FREE_TOKENS=50

# Comma-separated allowed CORS origins (installed by auth.install).
PHYTO_CORS_ORIGINS=

PHYTO_ADMIN_UIDS=
PHYTO_AUTH_AUDIT_LOG=
PHYTO_AUDIT_LOG=
SSO_DOMAINS=

# ---------------------------------------------------------------------------
# LLM routing (ADR-0046)
# ---------------------------------------------------------------------------
PHYTO_LLM_PROVIDER=local
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
PHYTO_FULL_MODEL=
PHYTO_DISTILLED_DISABLED=
VERTEX_ENDPOINT_ID=
VERTEX_LOCATION=
# ADR-0078: required for real-mode shift prediction (PHYTO_ENV=cloud,
# PHYTO_DRY_RUN unset or 0). Missing either refuses elucidation startup
# instead of silently serving the mock predictor. GOOGLE_CLOUD_PROJECT
# (above) supplies the project.
# GOOGLE_CLOUD_PROJECT=

# ---------------------------------------------------------------------------
# Literature / external APIs
# ---------------------------------------------------------------------------
NCBI_API_KEY=
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
GNPS_API_KEY=
PHYTO_ALLOW_PUBLIC_GNPS=
NEO4J_URI=
MZMINE_HOME=
PHYTO_NMR_FIXTURES=
REMOTE_MD5=

# ---------------------------------------------------------------------------
# Citation registry (ADR-0043)
# ---------------------------------------------------------------------------
ZENODO_TOKEN=
ZENODO_API_URL=https://zenodo.org/api

# ADR-0081: optional curated structure library (CSV: name, smiles,
# provenance, source). When set, elucidation candidate retrieval is a real
# capability in both planes; a missing or malformed file refuses startup.
# PHYTO_STRUCTURE_DB_PATH=
