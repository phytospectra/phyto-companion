# Environment template. Copy to `.env` and fill in real values.
#
# This file is tracked; `.env` is not. Never put a real credential in this
# file -- every value below is a placeholder. In production these are
# injected from Secret Manager (ADR-0032), not from a file.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# `cloud` enables real cloud clients; anything else (or unset) runs the
# offline mock plane.
PHYTO_ENV=local

# Force the mock plane even when PHYTO_ENV=cloud. The test suite and the
# `make serve` target rely on this.
# PHYTO_DRY_RUN=1

# ---------------------------------------------------------------------------
# Stripe (ADR-0047)
# ---------------------------------------------------------------------------
# API secret key. Without it, RealStripeClient refuses with 503 rather than
# silently using the mock in production.
STRIPE_SECRET_KEY=sk_test_...

# One recurring monthly price id per subscribable plan.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_LAB=price_...
STRIPE_PRICE_DEPARTMENT=price_...

# Webhook signing secret (Dashboard -> Developers -> Webhooks -> endpoint ->
# "Signing secret"). The handler verifies Stripe-Signature against this value
# and fails closed when it is unset. Set the real value in Secret Manager;
# the value here is a dummy.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------------------------
# Application URLs and sharing
# ---------------------------------------------------------------------------
PHYTO_APP_BASE_URL=http://localhost:8000

# HMAC key for share tokens (ADR-0044). Must be stable across restarts or
# every outstanding share link stops working.
SHARE_HMAC_KEY=change-me-in-production
SHARE_RATE_LIMIT_PER_MIN=30

# ---------------------------------------------------------------------------
# Auth service (ADR-0032, ADR-0045)
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=phyto-local

# Path to the Firebase service-account JSON. Required only when PHYTO_ENV=cloud;
# the local plane uses the mock verifier.
FIREBASE_CREDENTIALS_PATH=

# Override the auth gate's default (on in cloud, off locally): "1" enforces,
# "0" disables. Leave unset unless you are testing one specific mode.
PHYTO_AUTH_ENABLED=

# Monthly free allowance in tokens (ADR-0045).
PHYTO_FREE_TOKENS=50

# Comma-separated allowed CORS origins (installed by auth.install).
PHYTO_CORS_ORIGINS=

PHYTO_ADMIN_UIDS=
PHYTO_AUTH_AUDIT_LOG=
PHYTO_AUDIT_LOG=
SSO_DOMAINS=

# ---------------------------------------------------------------------------
# LLM routing (ADR-0046)
# ---------------------------------------------------------------------------
PHYTO_LLM_PROVIDER=local
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
PHYTO_FULL_MODEL=
PHYTO_DISTILLED_DISABLED=
VERTEX_ENDPOINT_ID=
VERTEX_LOCATION=
# ADR-0078: required for real-mode shift prediction (PHYTO_ENV=cloud,
# PHYTO_DRY_RUN unset or 0). Missing either refuses elucidation startup
# instead of silently serving the mock predictor. GOOGLE_CLOUD_PROJECT
# (above) supplies the project.
# GOOGLE_CLOUD_PROJECT=

# ---------------------------------------------------------------------------
# Literature / external APIs
# ---------------------------------------------------------------------------
NCBI_API_KEY=
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
GNPS_API_KEY=
PHYTO_ALLOW_PUBLIC_GNPS=
NEO4J_URI=
MZMINE_HOME=
PHYTO_NMR_FIXTURES=
REMOTE_MD5=

# ---------------------------------------------------------------------------
# Citation registry (ADR-0043)
# ---------------------------------------------------------------------------
ZENODO_TOKEN=
ZENODO_API_URL=https://zenodo.org/api
